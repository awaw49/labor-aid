# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
build/
dist/
.coverage
.coverage.*
htmlcov/

# 环境变量与本地配置
.env
.env.*
!.env.example

# macOS
.DS_Store

# 编辑器
.idea/
.vscode/

# 日志
*.log

